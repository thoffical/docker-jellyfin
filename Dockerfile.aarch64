# Start directly from an official multi-arch Ubuntu base image
FROM ubuntu:24.04

# Avoid frontend prompts during build
ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies, rclone, fuse, and the official Jellyfin server packages
RUN apt-get update && apt-get install -y \
    curl \
    gnupg \
    ca-certificates \
    rclone \
    fuse3 \
    && mkdir -p /usr/share/keyrings \
    # 1. Grab official Jellyfin GPG Key
    && curl -fsSL https://jellyfin.org | gpg --dearmor -o /usr/share/keyrings/jellyfin.gpg \
    # 2. Add the repository layout (autodetects arm64 vs amd64 perfectly)
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/jellyfin.gpg] https://repo.jellyfin.org/ubuntu noble main" | tee /etc/apt/sources.list.d/jellyfin.list \
    && apt-get update \
    # 3. Install the actual server cleanly
    && apt-get install -y jellyfin-server jellyfin-web \
    # Clean up apt caches to save space
    && rm -rf /var/lib/apt/lists/*

# Map to the platform's default web port
EXPOSE 8000
ENV JELLYFIN_HTTP_PORT=8000

# Set up application environment layouts
RUN mkdir -p /workspace/config /workspace/cache /workspace/data /workspace/music
RUN chmod -R 777 /workspace

# Copy your configuration maps and the launch scripts
COPY rclone.conf /workspace/rclone.conf
COPY entrypoint.sh /workspace/entrypoint.sh
RUN chmod +x /workspace/entrypoint.sh

# Pass application locations down to Jellyfin
ENV JELLYFIN_DATA_DIR=/workspace/data
ENV JELLYFIN_CONFIG_DIR=/workspace/config
ENV JELLYFIN_CACHE_DIR=/workspace/cache

ENTRYPOINT ["/workspace/entrypoint.sh"]
